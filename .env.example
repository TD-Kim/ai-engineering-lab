# 이 파일을 복사해 .env 를 만들고 값을 채운다. .env 는 .gitignore 에 등록되어 커밋되지 않는다.
#   bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
# 키 값은 이 파일(.env.example)에 절대 쓰지 않는다.

# Claude API (Part 1 P1-01 선택 스크립트, Part 2 이후)
ANTHROPIC_API_KEY=
# OpenAI 임베딩 API (Part 1 P1-02(Embedding) 이후 사용)
OPENAI_API_KEY=

# 사용할 모델 (코드에 박지 않고 여기서 바꾼다)
LLM_MODEL=claude-opus-5-5
EMBEDDING_MODEL=text-embedding-3-small

# P1-02 임베딩 공급자 선택: fake(기본, 네트워크 없음) | openai(OPENAI_API_KEY 필요) | sentence_transformers(로컬) | ollama(로컬 서버)
# 공급자를 바꾸면 EMBEDDING_MODEL 도 그 공급자의 모델 이름으로 함께 바꾼다(문서와 질문은 같은 모델, 모델을 바꾸면 전부 재임베딩).
#   openai                : text-embedding-3-small (기본)
#   sentence_transformers : intfloat/multilingual-e5-small (기본) 또는 BAAI/bge-m3 — 처음 실행 때 모델을 내려받는다
#   ollama                : Ollama 임베딩 모델 태그(ollama.com 라이브러리에서 확인 후 `ollama pull <태그>`), 주소는 아래 OLLAMA_BASE_URL
EMBEDDING_PROVIDER=fake

# P2-01B 공급자 선택: fake(기본, 네트워크 없음) | ollama(로컬 서버) | claude(API 키 필요)
LLM_PROVIDER=fake
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_BASE_URL=http://localhost:11434
