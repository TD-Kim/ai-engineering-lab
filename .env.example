# 이 파일을 복사해 .env 를 만들고 값을 채운다. .env 는 .gitignore 에 등록되어 커밋되지 않는다.
#   PowerShell: Copy-Item .env.example .env
#   bash:       cp .env.example .env
# 키 값은 이 파일(.env.example)에 절대 쓰지 않는다.

# Claude API
ANTHROPIC_API_KEY=
# OpenAI 임베딩 API
OPENAI_API_KEY=

# 사용할 모델 (코드에 박지 않고 여기서 바꾼다)
LLM_MODEL=claude-opus-5-5
EMBEDDING_MODEL=text-embedding-3-small

# 로컬 LLM (Ollama)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# 공급자 선택 예시 (직접 구현할 때 이름은 자유롭게 바꿔도 된다)
#   LLM_PROVIDER:       ollama | claude
#   EMBEDDING_PROVIDER: openai | sentence_transformers | ollama
# 임베딩 공급자를 바꾸면 EMBEDDING_MODEL 도 그 공급자의 모델로 바꾸고, 저장된 문서 벡터는 전부 다시 만든다.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=openai
